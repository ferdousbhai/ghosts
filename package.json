{
  "name": "ghosts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && pnpm --recursive build",
    "check": "pnpm typecheck && pnpm test && pnpm check:dist && pnpm check:exports",
    "check:dist": "node scripts/check-dist.mjs",
    "check:exports": "node -e \"const fs=require('node:fs');Promise.all(fs.readdirSync('packages').flatMap(p=>fs.existsSync('packages/'+p+'/dist')?fs.readdirSync('packages/'+p+'/dist').filter(f=>f.endsWith('.js')).map(f=>import('./packages/'+p+'/dist/'+f)):[]))\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
