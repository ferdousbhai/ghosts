{
  "name": "ghosts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm --recursive build",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm check:dist",
    "check:dist": "git diff --exit-code -- packages/*/dist",
    "check:exports": "node -e \"Promise.all([import('./packages/app-tool-cache/dist/index.js'),import('./packages/app-tool-cache/dist/cloudflare.js'),import('./packages/title-generation/dist/index.js')])\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
